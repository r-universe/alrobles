[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "cofid"]
	path = cofid
	url = https://github.com/alrobles/cofid
[submodule "genoaligner"]
	path = genoaligner
	url = https://github.com/alrobles/genoaligner-r
[submodule "maxentcpp"]
	path = maxentcpp
	url = https://github.com/alrobles/maxentcpp
[submodule "mddmaps"]
	path = mddmaps
	url = https://github.com/cran/mddmaps
[submodule "rosario"]
	path = rosario
	url = https://github.com/alrobles/rosario
[submodule "sobol"]
	path = sobol
	url = https://github.com/alrobles/sobol
[submodule "ucminfcpp"]
	path = ucminfcpp
	url = https://github.com/alrobles/ucminfcpp
[submodule "xnicher"]
	path = xnicher
	url = https://github.com/alrobles/xnicher
